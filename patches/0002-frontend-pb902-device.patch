+-- PocketBook Pro 902 (2010, firmware 2.x): 9.7" Vizplex 828x1200, buttons only, no frontlight.
+-- Measured on the real device: ARM1176 CPU without VFP/NEON, InkView event loop (no /hwevent), QueryGSensor() == 0.
+local PocketBook902 = PocketBook:extend{
+    model = "PB902",
+    display_dpi = 150,
+    isTouchDevice = no,
+    hasFrontlight = no,
+    hasNaturalLightApi = no,
+    hasDPad = yes,
+    -- turnOnWifi()/turnOffWifi() are implemented below (NetConnect/NetDisconnect), so KOReader's Wi-Fi menu and the
+    -- "Action when Wi-Fi is off / when done" settings (turn on / prompt, leave on / turn off) can be used.
+    hasWifiToggle = yes,
+    -- the firmware only brings its Wi-Fi link up on request (NetConnect): lets KOReader's "Restore Wi-Fi connection on resume"
+    -- and the Hardcover plugin's "Enable wifi on demand" connect by themselves
+    hasWifiRestore = yes,
+    hasSeamlessWifiToggle = no,
+    hasOTAUpdates = no,
+    canAssociateFileExtensions = no,
+    _model_init = function(self)
+        -- extra buttons seen on this device (more mappings after the key test):
+        self.input.event_map[-C.IV_KEY_BACK] = "Back"
+    end,
+    -- Firmware 2.x has no WiFiPower()/NetMgrPing(), and QueryNetwork() does not report the connection state in the
+    -- bits newer firmware uses, so the generic PocketBook code believed "Wi-Fi is off" although the firmware was connected.
+    -- The firmware manages Wi-Fi itself: we are "connected" when a default route exists.
+    initNetworkManager = function(self, NetworkMgr)
+        local function hasRoute()
+            return NetworkMgr:hasDefaultRoute() == true
+        end
+
+        function NetworkMgr:turnOnWifi(complete_callback)
+            -- ask the firmware to connect to a known network (it may show its own dialog)
+            local ok, err = pcall(inkview.NetConnect, nil)
+            if not ok then logger.warn("NetConnect failed:", err) end
+            if complete_callback then complete_callback() end
+        end
+
+        -- Called by KOReader's "Restore Wi-Fi connection on resume" and by the Hardcover plugin's "Enable wifi on demand".
+        -- NetConnect() blocks until the firmware is connected, so it runs from the UI loop a moment later, not inside init.
+        function NetworkMgr:restoreWifiAsync()
+            UIManager:scheduleIn(0.5, function()
+                local ok, err = pcall(inkview.NetConnect, nil)
+                if not ok then logger.warn("NetConnect (restore) failed:", err) end
+            end)
+        end
+
+        function NetworkMgr:turnOffWifi(complete_callback)
+            local ok, err = pcall(inkview.NetDisconnect)
+            if not ok then logger.warn("NetDisconnect failed:", err) end
+            if complete_callback then complete_callback() end
+        end
+
+        function NetworkMgr:isWifiOn()
+            return hasRoute()
+        end
+
+        local res_init_done = false
+        function NetworkMgr:isConnected()
+            local connected = hasRoute()
+            if connected and not res_init_done then
+                -- glibc parses /etc/resolv.conf only once: force a reload when the route first appears
+                local ok = pcall(function() ffi.C.res_init() end)
+                if not ok then pcall(function() ffi.C.__res_init() end) end
+                res_init_done = true
+            elseif not connected then
+                res_init_done = false
+            end
+            return connected
+        end
+
+        function NetworkMgr:isOnline()
+            return self:isConnected() and self:canResolveHostnames()
+        end
+    end,
+}
